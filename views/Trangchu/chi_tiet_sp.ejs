<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="Responsive Bootstrap4 Shop Template, Created by Imran Hossain from https://imransdesign.com/">
	<title><%= product.name %> - Quân Decor</title>
	<link rel="shortcut icon" type="image/png" href="../trangchu/assets/img/favicon.png">
	<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,700" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css?family=Poppins:400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="../trangchu/assets/css/all.min.css">
	<link rel="stylesheet" href="../trangchu/assets/bootstrap/css/bootstrap.min.css">
	<link rel="stylesheet" href="../trangchu/assets/css/owl.carousel.css">
	<link rel="stylesheet" href="../trangchu/assets/css/magnific-popup.css">
	<link rel="stylesheet" href="../trangchu/assets/css/animate.css">
	<link rel="stylesheet" href="../trangchu/assets/css/meanmenu.min.css">
	<link rel="stylesheet" href="../trangchu/assets/css/main.css">
	<link rel="stylesheet" href="../trangchu/assets/css/responsive.css">
</head>
<style>
	.mau-gia {
		font-size: 24px;
		color: #e74c3c;
		font-weight: bold;
	}
	.quantity-info {
		font-size: 12px;
		color: #666;
		margin-top: -10px;
		margin-bottom: 15px;
	}
</style>
<body>
    <!-- Add notification div after body tag -->
    <div id="notification" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); 
        background:rgba(0,0,0,0.8); color:white; padding:15px 25px; border-radius:5px; z-index:9999;">
        <div class="notification-content" style="text-align:center;">
            <i class="fas fa-check-circle" style="color:#4CAF50; margin-right:8px;"></i>
            <span>Đã thêm vào giỏ hàng</span>
        </div>
    </div>
    <div class="loader">
        <div class="loader-inner">
            <div class="circle"></div>
        </div>
    </div>
    <%- include('nav') %>
	<div class="bannerphu"></div>
	<div class="mt-150 mb-150">
        <div class="container">
            <div class="row">
                <div class="col-md-5">
                    <div class="single-product-img">
                        <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid">
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="single-product-pricing">
                        <h3><%= product.name %></h3>
                        <p class="mau-gia">
                            <span>Giá:</span> <%= product.salary ? product.salary.toLocaleString('vi-VN') + ' VNĐ' : 'Liên hệ' %>
                        </p>
                        <div class="single-product-desc">
                            <p class="mb-4"><%= product.mota || 'Chưa có mô tả' %></p>
                            
                            <p><strong>Ngày đăng:</strong> <%= product.date ? new Date(product.date).toLocaleDateString('vi-VN') : '' %></p>
                        </div>
                        <div class="product-actions mt-4">
                            <% if (product.soluong > 0) { %>
                                <div class="cart-form d-inline-block">
                                    <input type="hidden" id="productId-<%= product._id %>" value="<%= product._id %>">
                                    <div class="quantity-group mb-3">
                                        <label>Số lượng:</label>
                                        <input type="number" id="quantity-<%= product._id %>" value="1" min="1" max="<%= product.soluong %>" class="form-control d-inline-block" style="width: 100px">
                                        <div class="quantity-info">
                                            <small><strong>Số lượng còn:</strong> <%= product.soluong || 0 %></small>
                                        </div>
                                    </div>
                                                                        <button type="button" class="btn btn-primary"
                                                                            onclick="addToCartWithNotification('<%= product._id %>', parseInt(document.getElementById('quantity-<%= product._id %>').value || '1', 10))">
                                                                                <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                                                                        </button>
                                                                        <!-- Buy now: submit hidden form to /thanhtoan/buy so server renders checkout for this product -->
                                                                        <form id="buyNowForm-<%= product._id %>" action="/thanhtoan/buy" method="POST" style="display:inline-block;margin-left:8px;">
                                                                                <input type="hidden" name="items" value="<%= product._id %>">
                                                                                <input type="hidden" name="quantities" id="buyNowQty-<%= product._id %>" value="1">
                                                                                <button type="button" class="btn btn-success ml-2" onclick="submitBuyNow('<%= product._id %>')">Mua ngay</button>
                                                                        </form>
                                    <noscript>
                                      <!-- Fallback cho user không bật JS -->
                                      <form action="/cart/add" method="POST" style="display:inline-block">
                                        <input type="hidden" name="productId" value="<%= product._id %>">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
                                      </form>
                                    </noscript>
                                </div>
                            <% } else { %>
                                <button class="btn btn-secondary" disabled>Hết hàng</button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
	<!-- Sản phẩm cùng danh mục -->
	<div class="logo-carousel-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center mb-5">
                    <h3>Sản phẩm liên quan</h3>
                </div>
                <div class="logo-carousel-inner">
                    <% if (relatedProducts && relatedProducts.length > 0) { %>
                        <% relatedProducts.forEach(function(rProduct) { %>
                            <% if (rProduct._id.toString() !== product._id.toString()) { %>
                                <div class="single-logo-item">
                                    <div class="single-product-item">
                                        <div class="product-image">
                                            <a href="/san_pham/<%= rProduct._id %>">
                                                <img src="<%= rProduct.image %>" alt="<%= rProduct.name %>">
                                            </a>
                                        </div>
                                        <h3><%= rProduct.name %></h3>
                                        <p class="product-price">
                                            <%= rProduct.salary ? rProduct.salary.toLocaleString('vi-VN') + ' VNĐ' : 'Liên hệ' %>
                                        </p>
                                        <a href="/san_pham/<%= rProduct._id %>" class="cart-btn">
                                            <i class="fas fa-eye"></i> Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center w-100">
                            <p>Không có sản phẩm liên quan</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
	<!-- footer -->
	<%- include('footer') %>
	<!-- end footer -->
	<script src="../trangchu/assets/js/jquery-1.11.3.min.js"></script>
	<script src="../trangchu/assets/bootstrap/js/bootstrap.min.js"></script>
	<script src="../trangchu/assets/js/jquery.countdown.js"></script>
	<script src="../trangchu/assets/js/jquery.isotope-3.0.6.min.js"></script>
	<script src="../trangchu/assets/js/waypoints.js"></script>
	<script src="../trangchu/assets/js/owl.carousel.min.js"></script>
	<script src="../trangchu/assets/js/jquery.magnific-popup.min.js"></script>
	<script src="../trangchu/assets/js/jquery.meanmenu.min.js"></script>
	<script src="../trangchu/assets/js/sticker.js"></script>
	<script src="../trangchu/assets/js/main.js"></script>
	<script>
    $(document).ready(function(){
        $('.logo-carousel-inner').owlCarousel({
            loop: true,
            autoplay: true,
            margin: 30,
            nav: false,
            dots: false,
            responsive:{
                0:{
                    items:1
                },
                600:{
                    items:2
                },
                1000:{
                    items:4
                }
            }
        });
    });
</script>
<script>
    function showNotification() {
        const notification = document.getElementById('notification');
        if (!notification) return;
        
        notification.style.display = 'block';
        
        setTimeout(() => {
            notification.style.display = 'none';
        }, 1000);
    }

    async function addToCartWithNotification(productId, quantity) {
        try {
            const response = await fetch('/cart/add', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId, quantity })
            });

            if (response.ok) {
                showNotification();
            } else {
                const text = await response.text();
                alert(text || 'Thêm vào giỏ hàng thất bại');
            }
        } catch (error) {
            console.error('Lỗi:', error);
            alert('Có lỗi xảy ra khi thêm vào giỏ hàng');
        }
    }
    </script>
    <script>
        function submitBuyNow(productId) {
            try {
                const qtyInput = document.getElementById('quantity-' + productId);
                const qty = qtyInput ? parseInt(qtyInput.value || '1', 10) : 1;
                const hiddenQty = document.getElementById('buyNowQty-' + productId);
                if (hiddenQty) hiddenQty.value = qty > 0 ? qty : 1;
                const form = document.getElementById('buyNowForm-' + productId);
                if (form) form.submit();
                else window.location.href = '/thanhtoan';
            } catch (e) {
                console.error('submitBuyNow error', e);
                window.location.href = '/thanhtoan';
            }
        }
    </script>
</body>
</html>