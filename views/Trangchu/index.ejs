<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="Responsive Bootstrap4 Shop Template, Created by Imran Hossain from https://imransdesign.com/">
	<title>Quân Decor</title>
	<link rel="shortcut icon" type="image/png" href="../trangchu/assets/img/favicon.png">
	<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,700" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css?family=Poppins:400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="../trangchu/assets/css/all.min.css">
	<link rel="stylesheet" href="../trangchu/assets/bootstrap/css/bootstrap.min.css">
	<link rel="stylesheet" href="../trangchu/assets/css/owl.carousel.css">
	<link rel="stylesheet" href="../trangchu/assets/css/magnific-popup.css">
	<link rel="stylesheet" href="../trangchu/assets/css/animate.css">
	<link rel="stylesheet" href="../trangchu/assets/css/meanmenu.min.css">
	<link rel="stylesheet" href="../trangchu/assets/css/main.css">
	<link rel="stylesheet" href="../trangchu/assets/css/responsive.css">
</head>
<body>
  <div class="loader">
    <div class="loader-inner">
      <div class="circle"></div>
    </div>
  </div>
	<%- include('nav') %>
	<%- include('banner') %>
	<!-- features list section -->
	<div class="list-section pt-80 pb-80">
		<div class="container">
			<div class="row">
				<div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
					<div class="list-box d-flex align-items-center">
						<div class="list-icon">
							<i class="fas fa-shipping-fast"></i>
						</div>
						<div class="content">
							<h3>Miễn phí vận chuyển</h3>
							<p>Đơn hàng trên 500.000 VNĐ</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
					<div class="list-box d-flex align-items-center">
						<div class="list-icon">
							<i class="fas fa-phone-volume"></i>
						</div>
						<div class="content">
							<h3>Hỗ trợ 24/7</h3>
							<p>Hỗ trợ khách hàng mọi lúc</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-md-6">
					<div class="list-box d-flex justify-content-start align-items-center">
						<div class="list-icon">
							<i class="fas fa-sync"></i>
						</div>
						<div class="content">
							<h3>Hoàn tiền</h3>
							<p>Nhận hoàn tiền trong vòng 3 ngày!</p>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
	<!-- end features list section -->

	<!-- product section -->
    <div class="product-section mt-150 mb-150">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 text-center">
                    <div class="section-title">
                        <h3><span class="orange-text">Sản phẩm</span> của chúng tôi</h3>
                        <p>Mỗi sản phẩm là một điểm nhấn nghệ thuật cho ngôi nhà của bạn.</p>
                    </div>
                </div>
            </div>

            <div class="row product-lists">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <div class="col-lg-4 col-md-6 text-center">
                            <div class="single-product-item">
                                <a href="/san_pham/<%= product._id %>" class="product-link">
                                    <div class="product-image">
                                        <img src="<%= product.image %>" alt="<%= product.name %>">
                                    </div>
                                    <h3><%= product.name %></h3>
                                    <p class="product-price">
                                        <span><%= product.danhmuc ? product.danhmuc.danhmuc : 'Chưa phân loại' %></span>
                                        <%= product.salary.toLocaleString('vi-VN') %> VNĐ
                                    </p>
                                </a>
                                <a class="cart-btn" type="button" 
                                        onclick="addToCartWithNotification('<%= product._id %>', 1)">
                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center">
                        <p>Chưa có sản phẩm nào.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
	<!-- end product section -->
	<!-- advertisement section -->
	<div class="abt-section mb-150">
		<div class="container">
			<div class="row align-items-center"> <!-- Added align-items-center -->
				<div class="col-lg-6 col-md-12">
					<div class="video-container">
						<div id="player"></div>
					</div>
				</div>
				<div class="col-lg-6 col-md-12">
					<div class="abt-text">
						<h2>Chúng tôi là <span class="orange-text">Quân Decor</span></h2>
						<p>Quân Decor tự hào là đơn vị chuyên cung cấp các sản phẩm trang trí nội thất cao cấp, mang đến không gian sống tinh tế và đậm dấu ấn cá nhân cho từng khách hàng.</p>
						<p>Với sự kết hợp hài hòa giữa thẩm mỹ và chất lượng, chúng tôi luôn không ngừng sáng tạo để giúp bạn biến ngôi nhà trở thành nơi thể hiện phong cách và cảm xúc riêng.</p>
						<a href="about.html" class="boxed-btn mt-4">Tìm hiểu thêm</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end advertisement section -->
	<!-- footer -->
   <%- include('footer') %>
   <%- include('chat-icon') %>
	<!-- end footer -->
	<script src="../trangchu/assets/js/jquery-1.11.3.min.js"></script>
	<script src="../trangchu/assets/bootstrap/js/bootstrap.min.js"></script>
	<script src="../trangchu/assets/js/jquery.countdown.js"></script>
	<script src="../trangchu/assets/js/jquery.isotope-3.0.6.min.js"></script>
	<script src="../trangchu/assets/js/waypoints.js"></script>
	<script src="../trangchu/assets/js/owl.carousel.min.js"></script>
	<script src="../trangchu/assets/js/jquery.magnific-popup.min.js"></script>
	<script src="../trangchu/assets/js/jquery.meanmenu.min.js"></script>
	<script src="../trangchu/assets/js/sticker.js"></script>
	<script src="../trangchu/assets/js/main.js"></script>
	<script>
	(function(){
	var tag = document.createElement('script');
	tag.src = "https://www.youtube.com/iframe_api";
	var firstScript = document.getElementsByTagName('script')[0];
	firstScript.parentNode.insertBefore(tag, firstScript);
	})();

	var player;
	function onYouTubeIframeAPIReady() {
	player = new YT.Player('player', {
		videoId: 'Kdpt1H2EYxk', // thay đổi nếu cần
		playerVars: {
		autoplay: 1,
		controls: 1,
		rel: 0,
		modestbranding: 1,
		loop: 1,
		playlist: 'Kdpt1H2EYxk',
		playsinline: 1
		},
		events: {
		onReady: function(e) {
			try { e.target.mute(); } catch(e){}
			try { e.target.setPlaybackRate(1.25); } catch(e){}
			e.target.playVideo();
		},
		onStateChange: function(e) {
			if (e.data === YT.PlayerState.ENDED) {
			player.seekTo(0);
			player.playVideo();
			}
		}
		}
	});
	}
</script>
<script>
$(document).ready(function() {
    var $grid = $('.product-lists').isotope({
        itemSelector: '.col-lg-4'
    });
    
    $('.product-filters ul').on('click', 'li', function() {
        var filterValue = $(this).attr('data-filter');
        $('.product-filters ul li').removeClass('active');
        $(this).addClass('active');
        $grid.isotope({ filter: filterValue });
    });
    $grid.imagesLoaded().progress(function() {
        $grid.isotope('layout');
    });
});
</script>
<!-- Add this right after <body> tag -->
<div id="notification" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); 
    background:rgba(0,0,0,0.8); color:white; padding:15px 25px; border-radius:5px; z-index:9999;">
    <div class="notification-content" style="text-align:center;">
        <i class="fas fa-check-circle" style="color:#4CAF50; margin-right:8px;"></i>
        <span>Đã thêm vào giỏ hàng</span>
    </div>
</div>

<!-- Add this before </body> -->
<script>
function showNotification() {
    const notification = document.getElementById('notification');
    if (!notification) return;
    
    // Show notification
    notification.style.display = 'block';
    
    // Hide after 1 second
    setTimeout(() => {
        notification.style.display = 'none';
    }, 1000);
}

async function addToCartWithNotification(productId, quantity) {
    try {
        const response = await fetch('/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId, quantity })
        });

        if (response.ok) {
            showNotification();
        } else {
            const text = await response.text();
            alert(text || 'Thêm vào giỏ hàng thất bại');
        }
    } catch (error) {
        console.error('Lỗi:', error);
        alert('Có lỗi xảy ra khi thêm vào giỏ hàng');
    }
}
</script>
</body>
</html>