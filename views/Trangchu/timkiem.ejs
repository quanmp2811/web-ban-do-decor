    <!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Kết quả tìm kiếm">
        <title>Kết quả tìm kiếm - Quân Decor</title>
        <link rel="shortcut icon" type="image/png" href="/trangchu/assets/img/favicon.png">
        <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,700" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css?family=Poppins:400,700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/trangchu/assets/css/all.min.css">
        <link rel="stylesheet" href="/trangchu/assets/bootstrap/css/bootstrap.min.css">
        <link rel="stylesheet" href="/trangchu/assets/css/owl.carousel.css">
        <link rel="stylesheet" href="/trangchu/assets/css/magnific-popup.css">
        <link rel="stylesheet" href="/trangchu/assets/css/animate.css">
        <link rel="stylesheet" href="/trangchu/assets/css/meanmenu.min.css">
        <link rel="stylesheet" href="/trangchu/assets/css/main.css">
        <link rel="stylesheet" href="/trangchu/assets/css/responsive.css">
    </head>
    <body>

        <div id="notification" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); background:rgba(0,0,0,0.8); color:white; padding:15px 25px; border-radius:5px; z-index:9999;">
            <div class="notification-content" style="text-align:center;">
                <i class="fas fa-check-circle" style="color:#4CAF50; margin-right:8px;"></i>
                <span>Đã thêm vào giỏ hàng</span>
            </div>
        </div>

        <%- include('nav') %>
        <div class="bannerphu"></div>

        <div class="product-section">
            <div class="container">
                <hr />
                <h4>Kết quả tìm kiếm cho: "<%= query %>"</h4>
                <hr />
                <div class="row product-lists">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <div class="col-lg-4 col-md-6 mb-4 <%= product.danhmuc ? product.danhmuc._id : '' %>">
                                <div class="single-product-item text-center">
                                    <a href="/san_pham/<%= product._id %>" class="product-link text-decoration-none text-dark">
                                        <div class="product-image mb-2">
                                            <img src="<%= product.image || '/trangchu/assets/img/avaters/default.png' %>" alt="<%= product.name %>">
                                        </div>
                                        <h5 class="mb-1"><%= product.name %></h5>
                                        <p class="text-muted mb-1"><small><%= product.danhmuc ? product.danhmuc.danhmuc : 'Chưa phân loại' %></small></p>
                                        <p class="fw-bold mb-2"><%= (product.salary || product.price || 0).toLocaleString('vi-VN') %> VNĐ</p>
                                    </a>
                                    <a class="cart-btn" type="button" 
                                        onclick="addToCartWithNotification('<%= product._id %>', 1)">
                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng</a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-12 text-center">
                            <p>Không tìm thấy sản phẩm phù hợp cho "<%= query %>".</p>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination -->
                <% if (totalPages && totalPages > 1) { %>
                    <div class="row">
                        <div class="col-12 text-center">
                            <div class="pagination-wrap">
                                <ul>
                                    <% const range = 2; %>
                                    <% const start = Math.max(1, page - range); %>
                                    <% const end = Math.min(totalPages, page + range); %>

                                    <% if (page > 1) { %>
                                        <li><a href="?q=<%= encodeURIComponent(query) %>&page=<%= page - 1 %>">&lt;</a></li>
                                    <% } else { %>
                                        <li><a class="disabled">&lt;</a></li>
                                    <% } %>

                                    <% if (start > 1) { %>
                                        <li><a href="?q=<%= encodeURIComponent(query) %>&page=1">1</a></li>
                                        <% if (start > 2) { %><li><a class="disabled">...</a></li><% } %>
                                    <% } %>

                                    <% for (let i = start; i <= end; i++) { %>
                                        <% if (i === page) { %>
                                            <li><a class="active" href="?q=<%= encodeURIComponent(query) %>&page=<%= i %>"><%= i %></a></li>
                                        <% } else { %>
                                            <li><a href="?q=<%= encodeURIComponent(query) %>&page=<%= i %>"><%= i %></a></li>
                                        <% } %>
                                    <% } %>

                                    <% if (end < totalPages) { %>
                                        <% if (end < totalPages - 1) { %><li><a class="disabled">...</a></li><% } %>
                                        <li><a href="?q=<%= encodeURIComponent(query) %>&page=<%= totalPages %>"><%= totalPages %></a></li>
                                    <% } %>

                                    <% if (page < totalPages) { %>
                                        <li><a href="?q=<%= encodeURIComponent(query) %>&page=<%= page + 1 %>">&gt;</a></li>
                                    <% } else { %>
                                        <li><a class="disabled">&gt;</a></li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% } %>

            </div>
        </div>

        <%- include('footer') %>

        <script src="/trangchu/assets/js/jquery-1.11.3.min.js"></script>
        <script src="/trangchu/assets/bootstrap/js/bootstrap.min.js"></script>
        <script src="/trangchu/assets/js/jquery.countdown.js"></script>
        <script src="/trangchu/assets/js/jquery.isotope-3.0.6.min.js"></script>
        <script src="/trangchu/assets/js/waypoints.js"></script>
        <script src="/trangchu/assets/js/owl.carousel.min.js"></script>
        <script src="/trangchu/assets/js/jquery.magnific-popup.min.js"></script>
        <script src="/trangchu/assets/js/jquery.meanmenu.min.js"></script>
        <script src="/trangchu/assets/js/sticker.js"></script>
        <script src="/trangchu/assets/js/main.js"></script>
        <script>
            $(document).ready(function() {
                // isotope filter (if isotope loaded)
                try {
                    var $grid = $('.product-lists').isotope({ itemSelector: '.col-lg-4' });
                    $('.product-filters ul').on('click', 'li', function() {
                        var filterValue = $(this).attr('data-filter') || '*';
                        $('.product-filters ul li').removeClass('active');
                        $(this).addClass('active');
                        $grid.isotope({ filter: filterValue });
                    });
                } catch (e) {
                    // isotope not available — ignore
                }
            });

            function showNotification() {
                const notification = document.getElementById('notification');
                if (!notification) return;
                notification.style.display = 'block';
                setTimeout(() => { notification.style.display = 'none'; }, 1200);
            }

            async function addToCartWithNotification(productId, quantity) {
                try {
                    const response = await fetch('/cart/add', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, quantity })
                    });

                    if (response.ok) {
                        showNotification();
                    } else {
                        const text = await response.text();
                        alert(text || 'Thêm vào giỏ hàng thất bại');
                    }
                } catch (error) {
                    console.error('Lỗi:', error);
                    alert('Có lỗi xảy ra khi thêm vào giỏ hàng');
                }
            }
        </script>

    </body>
    </html>